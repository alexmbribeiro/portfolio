# ─────────────────────────────────────────────────────────────────────────────
# The live debate path. Everything below is OPTIONAL.
#
# Without a key the site is still fully functional: the cached debates are the
# default path, cost nothing and never fail. Only free-text claims need the API.
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# There is no free tier on the Anthropic API. One live debate is six calls
# (one per agent), so the model choice is the whole cost story.
#
#   claude-haiku-4-5  — the cheap end, and the default. Rough estimate: a few
#                       cents per debate.
#   claude-opus-5     — clearly better reasoning, roughly 5x the cost.
#
# These are estimates from token pricing, not measured on this app — run a few
# debates and check your Anthropic usage dashboard before trusting a number.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Reasoning effort: low | medium | high | xhigh | max.
# Ignored on Haiku 4.5, which does not accept an effort setting.
# ANTHROPIC_EFFORT=medium

# Spend ceiling, enforced as request caps. The cached path is unaffected by
# these, so lowering them degrades the live extra, never the site.
# DEBATE_PER_IP_PER_HOUR=2
# DEBATE_GLOBAL_PER_DAY=15
